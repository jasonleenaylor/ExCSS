<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net462</TargetFrameworks>
    <AssemblyName>ExCSS</AssemblyName>
    <RootNamespace>ExCSS</RootNamespace>
    <Version>2.1.0</Version>
    <AssemblyTitle>ExCSS Parser</AssemblyTitle>
    <Product>ExCSS CSS Parser</Product>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>ExCSS.snk</AssemblyOriginatorKeyFile>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>SIL.ExCSS</PackageId>
    <Title>ExCSS Stylesheet Parser</Title>
    <Authors>Tyler Brinks</Authors>
    <Description>ExCSS reads and parses stylesheets using CSS 3 and CSS 2 selector specifications, and is easily queryable from LINQ using its simple and readable object model.</Description>
    <PackageTags>ExCSS;CSS;Style;Stylesheet;Parse;Lexer;Scanner;Linq</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/sillsdev/ExCSS</PackageProjectUrl>
    <RepositoryUrl>https://github.com/sillsdev/ExCSS</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>readme.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- Leftovers from the ANTLR-based parser. The pre-SDK project never compiled them. -->
    <Compile Remove="Parser.generated.cs" />
    <Compile Remove="ParserX.cs" />
    <None Include="..\readme.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.InteropServices.ComVisibleAttribute">
      <_Parameter1>false</_Parameter1>
      <_Parameter1_IsLiteral>true</_Parameter1_IsLiteral>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.InteropServices.GuidAttribute">
      <_Parameter1>eb4daa16-725f-4c8f-9d74-b9b569d57f42</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
